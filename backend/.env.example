# 复制为 backend/.env 后按需修改；真实 .env 永不提交
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=habit
DB_PASSWORD=change_me
DB_NAME=habit_checkin

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

# 登录态 TTL：7 天（秒）
TOKEN_TTL_SECONDS=604800

APP_HOST=0.0.0.0
APP_PORT=8000

# Vite 开发服务器默认 5173，多个来源用英文逗号分隔
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
